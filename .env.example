# Launch flag — set to false to hide ValeCheck Rebuild (£14.99) from the
# storefront while it's not ready to launch. Defaults to true so local dev
# sees the full product.
REBUILD_ENABLED=true

# Launch flag — set to true once the subscription Stripe prices are set up
# (STRIPE_PRICE_TRADER/PRO/DEALER) and there's time to test them. Defaults
# to false so a missing env var never accidentally exposes it.
SUBSCRIPTIONS_ENABLED=false

# Pre-launch gate — a logged-out visitor sees a "coming soon" page and
# registration is closed, so the site can't be stumbled onto and used for
# free before payments are fully tested. Defaults to true; set to false
# to go fully live with no code changes.
COMING_SOON_ENABLED=true

APP_NAME=ValeCheck
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails to storage/logs/laravel.log instead of sending them —
# fine for local dev. Set to "postmark" in production and provide
# POSTMARK_API_KEY below (config/services.php already reads it).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_API_KEY=

# Where a submitted Enterprise contact-form enquiry is emailed to — defaults
# to stefan@silverbackcustomsuk.com if unset (see config/valecheck.php).
ENTERPRISE_CONTACT_EMAIL=

# The "s3" disk works against any S3-compatible provider, not just AWS —
# for Backblaze B2, use your B2 Application Key ID/Key as the access
# key/secret, your bucket's region code (e.g. eu-central-003) as the
# region, and set AWS_ENDPOINT to your bucket's S3-compatible endpoint,
# e.g. https://s3.eu-central-003.backblazeb2.com (find both the region
# code and endpoint on the bucket's details page in the B2 dashboard).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp

# Stripe Price IDs for the recurring subscription plans (create these as
# recurring GBP prices in the Stripe test dashboard — not fabricated here).
STRIPE_PRICE_TRADER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_DEALER=

# "anthropic" or "openai"
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# One Auto API (https://docs.oneautoapi.com/) — Experian AutoCheck +
# One Auto's own MOT History & Tax Status power the actual paid Check/Plus
# reports; Brego valuation powers Plus's market value. All three services
# must be enabled on the One Auto account, or every call will fail.
ONEAUTO_API_KEY=
ONEAUTO_BASE_URL=https://api.oneautoapi.com
# Sandbox for testing without spending real credits:
# ONEAUTO_BASE_URL=https://sandbox.oneautoapi.com
ONEAUTO_COST_PER_LOOKUP_NET=
ONEAUTO_PREVIEW_CACHE_MINUTES=30
# "mock" or "oneauto"
VEHICLE_DATA_PROVIDER=mock

# The free "is this your vehicle?" preview shown on the "Check Vehicle"
# click, before any payment/credit is spent. "mock", "dvla" (free, no
# model field) or "oneauto" (reuses the same MOT/Tax call as the paid
# report above, includes model).
REGISTRATION_LOOKUP_PROVIDER=mock
DVLA_API_KEY=
DVLA_BASE_URL=https://driver-vehicle-licensing.api.gov.uk

# Public listing import — pre-fills Rebuild listing details from a pasted
# public listing URL using only publicly-accessible structured metadata.
# Kill switch: set to false to disable the feature without a deploy.
LISTING_IMPORT_ENABLED=true
LISTING_IMPORT_USER_AGENT="ValeCheckBot/1.0 (+https://valecheck.co.uk/about-our-importer)"

# Report PDFs are stored on this disk (see config/filesystems.php) — "s3" in
# production, since local storage isn't guaranteed to persist across
# deploys/instances. Requires the AWS_* vars above to be set for real.
REPORT_PDF_DISK=s3
# Report content (photos, AI analysis, the PDF) is permanently deleted this
# many days after a report completes — see reports:purge-expired.
REPORT_RETENTION_DAYS=30
